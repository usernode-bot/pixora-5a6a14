{
  "description": "AI-powered creative tools for image generation, upscaling, background removal, and more",
  "secrets": [],
  "tests": [
    {
      "id": "batch.convert",
      "name": "Batch convert screen renders its queue and zip download",
      "path": "/",
      "expectSelector": "#drop-zone input[type=file][multiple]",
      "expectText": "Download all (.zip)",
      "visual": true,
      "impact": ["public/index.html", "public/js/**", "styles/**"]
    },
    {
      "id": "nav.tools",
      "name": "Sidebar lists every tool and the Remove Background page renders",
      "path": "/remove-background",
      "expectSelector": "nav a[href='/prompt-generator']",
      "expectText": "Remove Background isn't ready yet",
      "visual": true,
      "impact": ["public/index.html", "public/js/**", "styles/**"]
    }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🖼️"
  }
}
